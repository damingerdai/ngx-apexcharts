{
  "name": "ngx-apexcharts",
  "version": "1.0.0",
  "description": "An angular implementation of ApexCharts",
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "apexcharts": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "keywords": [
    "angular",
    "apexcharts",
    "charts",
    "statistics",
    "ui"
  ],
  "author": {
    "name": "Morris Janatzek"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/damingerdai/ngx-apexcharts/issues"
  },
  "homepage": "https://github.com/damingerdai/ngx-apexcharts",
  "dependencies": {
    "tslib": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/damingerdai/ngx-apexcharts.git"
  },
  "ng-add": {
    "save": "dependencies"
  },
  "schematics": "./schematics/collection.json",
  "ng-update": {
    "packageGroup": [
      "ngx-apexcharts"
    ],
    "migrations": "./schematics/migrations.json"
  }
}
