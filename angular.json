{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "3baaf504-dbc1-40db-9aea-56a6da334a34",
    "schematicCollections": ["angular-eslint"]
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-apexcharts-demo": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:module": {},
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/ngx-apexcharts-demo"
            },
            "index": "src/index.html",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "src/tsconfig.app.json",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.scss"],
            "scripts": [],
            "aot": true,
            "extractLicenses": true,
            "sourceMap": true,
            "optimization": true,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                }
              ]
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ngx-apexcharts-demo:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "ngx-apexcharts-demo:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "ngx-apexcharts-demo:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "src/tsconfig.spec.json",
            "reporters": [
              "default"
            ],
            "coverageReporters": [
              "html",
              "text-summary",
              "lcovonly"
            ],
            "setupFiles": [
              "src/test.ts"
            ],
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        }
      }
    },
    "ngx-apexcharts": {
      "root": "projects/ngx-apexcharts",
      "sourceRoot": "projects/ngx-apexcharts/src",
      "projectType": "library",
      "prefix": "apx",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-apexcharts/tsconfig.lib.json",
            "project": "projects/ngx-apexcharts/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/ngx-apexcharts/src/test.ts",
            "tsConfig": "projects/ngx-apexcharts/tsconfig.spec.json",
            "karmaConfig": "projects/ngx-apexcharts/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-apexcharts/**/*.ts",
              "projects/ngx-apexcharts/**/*.html"
            ],
            "eslintConfig": "projects/ngx-apexcharts/eslint.config.mjs"
          }
        }
      }
    },
    "dev-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/dev-app",
      "sourceRoot": "projects/dev-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dev-app",
            "index": "projects/dev-app/src/index.html",
            "browser": "projects/dev-app/src/main.ts",
            "polyfills": [],
            "tsConfig": "projects/dev-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["projects/dev-app/src/styles.scss"],
            "scripts": [],
            "server": "projects/dev-app/src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "projects/dev-app/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "dev-app:build:production"
            },
            "development": {
              "buildTarget": "dev-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/dev-app/tsconfig.spec.json",
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/dev-app/**/*.ts",
              "projects/dev-app/**/*.html"
            ],
            "eslintConfig": "projects/dev-app/eslint.config.js"
          }
        }
      }
    },
    "docs-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/docs-app",
      "sourceRoot": "projects/docs-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/docs-app",
            "index": "projects/docs-app/src/index.html",
            "browser": "projects/docs-app/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/docs-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/docs-app/public"
              },
              {
                "glob": "**/*",
                "input": "./docs",
                "output": "/docs-content"
              }
            ],
            "styles": [
              "projects/docs-app/src/styles.scss",
              {
                "input": "projects/docs-app/src/highlightjs/material-light.scss"
              }
            ],
            "scripts": [],
            "server": "projects/docs-app/src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "projects/docs-app/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "projects/docs-app/public"
                }
              ],
              "styles": [
                "@angular/material/prebuilt-themes/azure-blue.css",
                "projects/docs-app/src/styles.scss"
              ],
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "docs-app:build:production"
            },
            "development": {
              "buildTarget": "docs-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/docs-app/tsconfig.spec.json",
            "buildTarget": ":build:testing",
            "runner": "vitest"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/docs-app/**/*.ts",
              "projects/docs-app/**/*.html"
            ],
            "eslintConfig": "projects/docs-app/eslint.config.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
