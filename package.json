{
  "name": "ngx-apexcharts-demo",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve dev-app",
    "start:doc": "ng serve docs-app",
    "prestart:doc": "tsx ./tools/markdown-to-html/transform-markdown.mts && ng serve docs-app",
    "build-pkg": "ng build ngx-apexcharts",
    "build-schematics": "tsc -p ./projects/ngx-apexcharts/schematics/tsconfig.json --outDir dist/ngx-apexcharts/schematics",
    "build:doc": "tsx ./tools/markdown-to-html/transform-markdown.mts && ng build docs-app",
    "build-docs-content": "tsx ./tools/markdown-to-html/transform-markdown.mts",
    "sync-apex-types": "tsx ./tools/sync-apex-types/index.mts",
    "build": "ng build dev-app && ng build docs-app",
    "test-lib": "ng test ngx-apexcharts",
    "test:lib:ci": "ng test ngx-apexcharts --watch=false --coverage",
    "test-schematics": "vitest run --config vitest.schematics.config.mts",
    "test": "npm run test-lib -- --watch=false && npm run test-schematics",
    "test:ci": "npm run test:lib:ci && npm run test-schematics",
    "lint": "ng lint ngx-apexcharts && ng lint ngx-apexcharts-demo && ng lint dev-app && ng lint docs-app",
    "lint:fix": "ng lint ngx-apexcharts --fix && ng lint ngx-apexcharts-demo --fix && ng lint dev-app --fix && ng lint docs-app --fix",
    "package": "npm run build-pkg && npm run build-schematics",
    "copyfile:lincense": "copyfiles ./LICENSE ./dist/ngx-apexcharts",
    "copyfile:schema": "copyfiles -f ./projects/ngx-apexcharts/schematics/ng-add/schema.json ./dist/ngx-apexcharts/schematics/ng-add",
    "copyfile:collection": "copyfiles -f ./projects/ngx-apexcharts/schematics/collection.json ./projects/ngx-apexcharts/schematics/migrations.json ./projects/ngx-apexcharts/schematics/package.json ./dist/ngx-apexcharts/schematics",
    "copyfile:npmignore": "copyfiles -f ./projects/ngx-apexcharts/.npmignore ./dist/ngx-apexcharts",
    "copyfile": "npm run copyfile:lincense && npm run copyfile:schema && npm run copyfile:collection && npm run copyfile:npmignore",
    "release": "cd ./projects/ngx-apexcharts && standard-version",
    "release:patch": "cd ./projects/ngx-apexcharts && standard-version --release-as patch",
    "release:minor": "cd ./projects/ngx-apexcharts && standard-version --release-as minor",
    "release:major": "cd ./projects/ngx-apexcharts && standard-version --release-as major",
    "publish": "npm run package && npm run copyfile && npm publish dist/ngx-apexcharts/",
    "prepare": "is-ci || husky",
    "serve:ssr:dev-app": "node dist/dev-app/server/server.mjs",
    "serve:ssr:docs-app": "node dist/docs-app/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@schematics/angular": "^22.0.1",
    "apexcharts": "8.4.1",
    "express": "^5.0.0",
    "path-normalize": "^6.0.13",
    "rxjs": "~7.8.0",
    "tslib": "2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.3.0",
    "@angular-devkit/schematics": "^22.3.0",
    "@angular-eslint/builder": "22.8.0",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.7.0",
    "@vitest/coverage-v8": "4.1.8",
    "angular-eslint": "22.8.0",
    "commit-and-tag-version": "^9.3.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.0",
    "highlight.js": "11",
    "husky": "9.1.7",
    "is-ci": "^4.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^27.0.0",
    "lint-staged": "16.4.0",
    "marked": "^16.0.0",
    "shelljs": "^0.10.0",
    "simple-git": "^3.27.0",
    "slugify": "^1.6.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.59.4",
    "vitest": "4.1.8"
  },
  "overrides": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.2.3"
  }
}
